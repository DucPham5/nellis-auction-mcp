# Copy this file to `.env` and fill in values. `.env` is git-ignored — never commit it.
# Public defaults are baked into nellis/config.py, so search works with NO .env at all.

# --- Secret: your Nellis login session (needed only for get_active_bids / get_watchlist) ---
# Log into nellisauction.com in your browser, then DevTools -> Application ->
# Cookies -> nellisauction.com, find the cookie named `__session`, and paste just
# its VALUE here (not "__session=", not the other cookies on the page).
NELLIS_SESSION_COOKIE=

# --- Public Algolia search credentials (optional overrides) ---
# Only uncomment/set these if Nellis rotates the public keys and search breaks.
# NELLIS_ALGOLIA_APP_ID=GL1QVP8R29
# NELLIS_ALGOLIA_API_KEY=d22f83c614aa8eda28fa9eadda0d07b9
# NELLIS_ALGOLIA_INDEX=nellisauction-prd
